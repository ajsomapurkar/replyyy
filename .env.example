# Copy to apps/api/.env or export. Placeholders only — never commit real secrets.
# --- Supabase (recommended): Project Settings → Database → Connection string → "Session pooler" (port 5432)
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# TLS is turned on automatically for supabase hosts (or set DATABASE_SSL=true for other hosted Postgres).
# --- Local Postgres / Docker
DATABASE_URL=postgres://relay:relay@localhost:5432/relay
# Tests drop & recreate Relay's tables — point this at a local DB or a throwaway Supabase project, never production.
TEST_DATABASE_URL=postgres://relay:relay@localhost:5432/relay_test
PORT=4000
CORS_ORIGIN=*
ROUTING_PROVIDER=mock        # mock | osrm
OSRM_URL=                    # e.g. http://localhost:5000 when ROUTING_PROVIDER=osrm
SIM_SPEED=4                  # demo drivers move 4x real time
SIMULATION=on                # off = no simulated fleet/demand
BACKGROUND_DEMAND=on
OFFER_TTL_SECONDS=20
STALE_LOCATION_SECONDS=30
