# Paste these into your host's Environment Variables screen (Render / Railway / Fly).
# Don't commit a real .env — it's gitignored.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (port 5432).
# Use the pooler, NOT the direct db.<ref>.supabase.co host (IPv6-only; most hosts can't reach it).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SIMULATION=on
BACKGROUND_DEMAND=on
SIM_SPEED=4
ROUTING_PROVIDER=mock
CORS_ORIGIN=*
# PORT is set by the host automatically.
